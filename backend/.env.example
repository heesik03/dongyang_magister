# Cloudtype 외부 TCP 접속 정보로 호스트와 포트를 교체합니다.
DB_URL=jdbc:mariadb://<external-host>:<external-port>/magister
DB_USERNAME=root
DB_PASSWORD=replace-with-your-db-password
JPA_DDL_AUTO=update
# 로컬 개발 기본값(lax / false). prod 프로필에서는 자동으로 SameSite=None, Secure=true가 적용됩니다.
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
GEMINI_API_KEY=replace-with-your-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=30s
GEMINI_CHARACTER_IMAGE_MODEL=gemini-3.1-flash-image
CHARACTER_IMAGE_DAILY_LIMIT=3
# 여러 서버에서 같은 미리보기 토큰을 확인할 때만 설정 (32자 이상 비밀 값)
ANALYSIS_PREVIEW_SIGNING_KEY=
ENCYKOREA_API_KEY=
